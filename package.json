{
  "name": "fleet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "benchmark:threejs": "node scripts/benchmark-threejs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src --passWithNoTests",
    "dev:slack": "pnpm --filter @fleet/slack dev",
    "test:slack": "pnpm --filter @fleet/client test && pnpm --filter @fleet/slack test",
    "test:slack-backend": "tsx scripts/test-slack-backend.ts",
    "build:slack": "pnpm --filter @fleet/client build && pnpm --filter @fleet/slack build",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm --filter @fleet/client typecheck && pnpm --filter @fleet/client test && pnpm --filter @fleet/client build && pnpm --filter @fleet/slack typecheck && pnpm --filter @fleet/slack test && pnpm --filter @fleet/slack build"
  },
  "dependencies": {
    "@fleet/client": "workspace:*",
    "@radix-ui/react-select": "2.3.7",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-start": "1.168.46",
    "ai": "7.0.58",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.31.0",
    "motion": "13.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.185.1",
    "workflow": "4.8.3",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.1",
    "nitro": "3.0.260311-beta",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "vite": "8.2.1",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.12.0 <26"
  },
  "pnpm": {
    "overrides": {
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  }
}
