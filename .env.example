SAIL_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
AI_GATEWAY_API_KEY=
SAIL_BASE_URL=https://api.sailresearch.com/v1
SAIL_RESEARCH_MODEL=deepseek-ai/DeepSeek-V4-Flash
AI_GATEWAY_ORCHESTRATOR_MODEL=openai/gpt-5.6-sol
# Optional Sail rates make its token usage costed rather than marked unpriced.
SAIL_INPUT_USD_PER_MILLION=
SAIL_OUTPUT_USD_PER_MILLION=
# Clerk authentication. Both values are required outside Clerk keyless development.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Leave blank for local execution in development and durable Workflow execution on Vercel.
# Set explicitly to "local" or "workflow" only when overriding auto-detection.
FLEET_EXECUTION_MODE=
# Required in Workflow mode for ownership and durable idempotency.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Atomic Redis admission and abuse controls.
FLEET_MAX_GLOBAL_CONCURRENCY=32
FLEET_MAX_ACTIVE_RUNS_PER_USER=2
FLEET_DAILY_TOKEN_BUDGET=5000000
FLEET_CREATE_REQUESTS_PER_MINUTE=6
FLEET_READ_REQUESTS_PER_MINUTE=120
FLEET_ADMISSION_LEASE_SECONDS=86400
